# Exemple — ne jamais committer de vraies clés
MARKET_DATA_API_KEY=
TWELVEDATA_API_KEY=
NEWS_API_KEY=
SOCIAL_API_KEY=
AI_PROVIDER_KEY=

# Optionnel en dev : sans ces deux variables, l'API tourne avec un journal
# d'audit en mémoire et sans cache de données live (voir README).
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=

# Client (Vite) — URL de l'API pour le panneau Paper Trading. Par défaut
# http://localhost:8787 si non défini.
VITE_API_BASE_URL=http://localhost:8787

# v3.4 Security / production core
AUTH_ENABLED=false
ALLOW_SELF_REGISTRATION=false
DEMO_ADMIN_EMAIL=admin@ter.local
DEMO_ADMIN_PASSWORD=change-me-now
SESSION_HOURS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
CORS_ORIGIN=http://localhost:5173
